--- /dev/null
+++ b/.github/workflows/deploy-backend.yml
@@ -0,0 +1,102 @@
+name: Deploy backend to EC2
+
+on:
+  push:
+    branches: [prod]
+    paths:
+      - "backend/**"
+      - ".github/workflows/deploy-backend.yml"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+# Never run two deploys at once; a newer push waits for the current one.
+concurrency:
+  group: deploy-backend
+  cancel-in-progress: false
+
+jobs:
+  # Safety net: even if someone bypasses branch protection, broken code is not deployed.
+  test:
+    uses: ./.github/workflows/ci.yml
+
+  deploy:
+    name: Build, push and deploy
+    needs: test
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    permissions:
+      id-token: write   # lets GitHub prove its identity to AWS (OIDC), no stored keys
+      contents: read
+    env:
+      ECR_REPOSITORY: ${{ vars.ECR_REPOSITORY }}
+      EC2_INSTANCE_ID: ${{ vars.EC2_INSTANCE_ID }}
+      API_URL: ${{ vars.API_URL }}
+    steps:
+      - uses: actions/checkout@v6
+
+      - name: Configure AWS credentials (OIDC)
+        uses: aws-actions/configure-aws-credentials@v6
+        with:
+          role-to-assume: ${{ vars.AWS_ROLE_ARN }}
+          aws-region: ${{ vars.AWS_REGION }}
+
+      - name: Log in to ECR
+        id: ecr
+        uses: aws-actions/amazon-ecr-login@v2
+
+      - name: Build and push image
+        id: image
+        env:
+          REGISTRY: ${{ steps.ecr.outputs.registry }}
+        run: |
+          IMAGE="$REGISTRY/$ECR_REPOSITORY:${GITHUB_SHA}"
+          docker build -t "$IMAGE" backend
+          docker push "$IMAGE"
+          echo "image=$IMAGE" >> "$GITHUB_OUTPUT"
+
+      # No SSH and no open port 22: AWS Systems Manager runs the deploy script on the instance.
+      - name: Deploy on EC2 (SSM)
+        env:
+          IMAGE: ${{ steps.image.outputs.image }}
+        run: |
+          CMD="/usr/local/bin/watchparty-deploy $IMAGE $GITHUB_REPOSITORY $GITHUB_SHA"
+          PARAMS="$(jq -n --arg c "$CMD" '{commands: [$c]}')"
+
+          CMD_ID="$(aws ssm send-command \
+            --instance-ids "$EC2_INSTANCE_ID" \
+            --document-name AWS-RunShellScript \
+            --comment "deploy ${GITHUB_SHA::7}" \
+            --timeout-seconds 600 \
+            --parameters "$PARAMS" \
+            --query Command.CommandId --output text)"
+          echo "SSM command: $CMD_ID"
+
+          status=Pending
+          for _ in $(seq 1 120); do          # up to 10 minutes
+            sleep 5
+            status="$(aws ssm get-command-invocation --command-id "$CMD_ID" --instance-id "$EC2_INSTANCE_ID" \
+              --query Status --output text 2>/dev/null || echo Pending)"
+            case "$status" in Success|Failed|Cancelled|TimedOut) break ;; esac
+          done
+
+          echo "----- output from the instance -----"
+          aws ssm get-command-invocation --command-id "$CMD_ID" --instance-id "$EC2_INSTANCE_ID" \
+            --query StandardOutputContent --output text || true
+          aws ssm get-command-invocation --command-id "$CMD_ID" --instance-id "$EC2_INSTANCE_ID" \
+            --query StandardErrorContent --output text || true
+          echo "------------------------------------"
+
+          if [ "$status" != "Success" ]; then
+            echo "Deploy finished with status: $status"
+            exit 1
+          fi
+
+      - name: Smoke test
+        run: |
+          for _ in $(seq 1 12); do
+            curl -fsS "$API_URL/health" && exit 0
+            sleep 5
+          done
+          echo "Health check failed after deploy"; exit 1
