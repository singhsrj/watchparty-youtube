# --- Database (Neon) ---------------------------------------------------------
# Direct connection. Used for schema creation and scripts/migrate_to_neon.py.
DATABASE_URL=
# Pooled connection (host contains "-pooler"). Used by the running app. Optional:
# if unset, the app uses DATABASE_URL.
DATABASE_URL_POOLED=

# Local development without Postgres: leave both unset to fall back to SQLite.

FRONTEND_URL=http://localhost:5173
SECRET_KEY=your-secret-key-change-in-production
